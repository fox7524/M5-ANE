# ==========================================
# M5 ULTIMATE - ROOT GITIGNORE
# ==========================================

# 1. macOS System Files
.DS_Store
.AppleDouble
.LSOverride
Icon

# 2. Build Artifacts & Compiled Binaries
build/
*.o
*.out
*.log
.cache/
__pycache__/
*.pyc

# 3. Third-Party Dependencies
node_modules/

# 4. Old & Heavy Folders (Do not track these giant archives)
OLD/lmstd/
OLD/saves/
OLD/llama.cpp/
OLD/mlx/
OLD/m1n1/
OLD/ANE-main/
OLD/MI/
OLD/insert_dylib/
OLD/payloads/

# 5. M5 Ultimate Specific Caches
/tmp/m5_*.log
/tmp/m5_*.command

# 6. Allow committing specific binaries and apps inside our active project folders
!M5 Ultimate/M5UltimateApp/build/M5\ Ultimate.app/
!M5 Ultimate/M5UltimateApp/build/M5\ Ultimate.app/**/*
!M5 Engines/**/*.dylib
